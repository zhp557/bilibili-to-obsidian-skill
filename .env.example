# 复制成 .env 再填。只有 ASR 那一档需要 key，纯字幕路线不需要。
# .env 已在 .gitignore 里，不会被提交。

# ---- 云端 ASR（可选）----
# 填一个即可，按顺序找：ASR_API_KEY → OPENAI_API_KEY → DASHSCOPE_API_KEY
ASR_API_KEY=

# HTTP 端点：必须支持 multimodal-generation 协议（不是所有 OpenAI 兼容网关都有）
# 留空 = 阿里云百炼官方端点，此时用 DASHSCOPE_API_KEY
# 填了自定义地址 = 只认 ASR_API_KEY，避免把别家的 key 发到陌生 URL
ASR_HTTP_ENDPOINT=
# 模型名；留空用 qwen3-asr-flash。模型名会随服务商版本变化，以 /models 列表为准
ASR_MODEL=

# ---- 路径（都可留空，默认落在当前目录下的 work/）----
BILI_NOTES_WORKDIR=
BILI_NOTES_VAULT=
BILI_NOTES_COOKIE=
BILI_NOTES_FFMPEG=

# ---- HTTP 后端：auto（默认，urllib 优先、被风控时回退 curl）/ urllib / curl ----
BILI_NOTES_HTTP=auto
